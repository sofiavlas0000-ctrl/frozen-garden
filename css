
* {
  box-sizing: border-box;
}

html,
body {
  width: 100%;
  height: 100%;
  margin: 0;
  overflow: hidden;
  background: #0c1018;
  font-family: ui-monospace, Consolas, monospace;
  user-select: none;
}

#game-shell {
  position: fixed;
  inset: 0;
  display: grid;
  place-items: center;
  overflow: hidden;
  background: #0c1018;
}

#game {
  display: block;
  width: min(100vw, 177.7778vh);
  height: min(56.25vw, 100vh);
  max-width: 100vw;
  max-height: 100vh;
  aspect-ratio: 16 / 9;
  background: #172033;
  image-rendering: pixelated;
  outline: none;
  touch-action: none;
  cursor: pointer;
}
